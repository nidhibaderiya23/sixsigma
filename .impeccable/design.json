 "narrative": {
  "northStar": "The Lab Report",
  "overview": "ERGent v3 is the quality console an EMS medical director would want on a bright desk and a class would want on a washed-out projector: a cool grey canvas, white surfaces separated by hairlines, and dark ink that survives any lamp. Everything in range reads in plain ink; anything out of range carries a tinted flag, the way a clinical lab report prints normal values plainly and flags the abnormal ones. One deep clinical teal owns the shell band, the primary action, selection and focus; green, amber and red are reserved for status.",
  "keyCharacteristics": [
   "A full-width deep teal header band; everything else is light.",
   "Counts sit in a joined vitals strip, never floating cards.",
   "Lists are flow sheets: rows separated by hairlines, no boxes.",
   "Status is a flag (tinted fill plus dark ink of the same hue), shown only when it carries meaning.",
   "One family, Source Sans 3, with tabular figures everywhere."
  ],
  "rules": [
   {
    "name": "The Lab Flag Rule",
    "body": "In-range values print in plain ink with no fill. Only an out-of-range value gets a flag: its ink turns the status ink and it sits on the status tint. Every status ink passes 5:1 on its own tint.",
    "section": "colors"
   },
   {
    "name": "The Reserved Status Rule",
    "body": "Green, amber and red never decorate and never label a data category. The chart stages use their own validated hues (violet, rose, blue).",
    "section": "colors"
   },
   {
    "name": "The One Family Rule",
    "body": "Source Sans 3 carries every role, including chart text: SVG charts keep their text as text so the browser sets it in the page font.",
    "section": "typography"
   }
  ],
  "dos": [
   "Do print in-range values in plain Ink and flag only out-of-range ones (The Lab Flag Rule).",
   "Do keep every figure tabular and every label sentence case.",
   "Do give charts the full width at 1200px or narrower.",
   "Do use Clinical Teal for action, selection and focus, and nothing else."
  ],
  "donts": [
   "Don't use green, amber or red for decoration or for data categories.",
   "Don't float KPI numbers in separate cards; join them in the vitals strip.",
   "Don't box list rows or nest cards.",
   "Don't add uppercase tracked labels, glow, gradients, blur or coloured side stripes.",
   "Don't bring back the dark command-center ground of version 1."
  ]
 }
}